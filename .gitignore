**/node_modules/
**/.npm/
**/.pnpm-store/

# Build
**/dist/
**/build/
**/.vite/
**/.next/
**/out/

# Environment variables
**/.env
**/.env.*
!**/.env.example

# Logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/pnpm-debug.log*

