# React / Frontend
# ==========================================

frontend_reactTs/.eslintcache
frontend_reactTs/.cache

# ==========================================
# Express Backend
# ==========================================

backend_express/uploads/*
!backend_express/uploads/.gitkeep

# ==========================================
# Django / DRF
# ==========================================

# Virtual environment
backend_drf/.venv/
backend_drf/venv/
backend_drf/env/

# Python cache
**/__pycache__/
**/*.py[cod]
**/*.pyo

# Django
backend_drf/.pytest_cache/
backend_drf/.coverage
backend_drf/htmlcov/

# SQLite database
backend_drf/db.sqlite3
backend_drf/db.sqlite3-journal

# Django media/uploads
backend_drf/media/*
!backend_drf/media/.gitkeep

# Static files generated by collectstatic
backend_drf/staticfiles/

